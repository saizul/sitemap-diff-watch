{
  "store": { "type": "json", "path": "snapshots", "compress": true },
  "reports": {
    "dir": "reports",
    "formats": ["md", "html", "json", "rss"],
    "maxItems": 200,
    "baseUrl": "https://your-name.github.io/sitemap-watch/"
  },
  "http": {
    "userAgent": "sitemap-diff-watch (+https://github.com/saizul/sitemap-diff-watch)",
    "timeoutMs": 60000,
    "retries": 2,
    "concurrency": 4
  },
  "keep": 120,
  "historyWindow": 12,
  "validate": {
    "robots": true,
    "robotsUserAgent": "Googlebot",
    "head": false,
    "futureToleranceHours": 24
  },
  "alerts": {
    "rules": { "minAdded": 1, "minRemoved": 1, "minRemovedPct": 10, "onErrors": true, "onFetchErrors": true },
    "maxUrls": 10,
    "channels": [
      { "type": "slack", "url": "${SLACK_WEBHOOK_URL}" },
      { "type": "telegram", "botToken": "${TELEGRAM_BOT_TOKEN}", "chatId": "${TELEGRAM_CHAT_ID}" },
      { "type": "webhook", "url": "${ALERT_WEBHOOK_URL}", "secret": "${ALERT_WEBHOOK_SECRET}" }
    ]
  },
  "sites": [
    {
      "name": "my-site",
      "sitemaps": ["https://www.example.com/sitemap_index.xml"],
      "sectionDepth": 1,
      "validate": {
        "canonicalHost": "www.example.com",
        "canonicalProtocol": "https:",
        "head": { "maxUrls": 100, "ratePerSecond": 2, "concurrency": 2 }
      },
      "alerts": { "rules": { "minLastmodChanged": 50 } }
    },
    {
      "name": "competitor-shop",
      "discover": "https://shop.example.net/",
      "maxDepth": 2,
      "maxSitemaps": 200,
      "sectionDepth": 2,
      "include": ["/products/**", "/blog/**"],
      "exclude": ["/blog/tag/**", "re:[?&]utm_"],
      "excludeSitemaps": ["/page-sitemap*.xml"],
      "validate": { "enabled": false },
      "alerts": { "rules": { "minAdded": 20, "minRemoved": 20, "onErrors": false } }
    }
  ]
}
